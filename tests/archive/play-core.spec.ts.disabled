import { test, expect } from "@playwright/test";
import AxeBuilder from "@axe-core/playwright";

test.use({ reducedMotion: "no-preference", viewport: { width: 1440, height: 900 } });

test("hero unfolds, selects artwork, enters a world and reverses", async ({ page }) => {
  const errors: string[] = [];
  page.on("pageerror", error => errors.push(error.message));
  await page.goto("/");
  const hero = page.locator(".play-core-hero");
  await expect(hero).toHaveClass(/core-ready/);
  await expect(hero.locator("canvas")).toHaveCount(1);
  const audit = await new AxeBuilder({ page }).include(".play-core-hero").analyze();
  expect(audit.violations.map(violation => violation.id)).toEqual([]);
  await page.getByRole("button", { name: "02 Unfold", exact: true }).click();
  await expect(hero).toHaveAttribute("data-chapter", "1");
  await expect(page.locator(".core-unfold")).toHaveCSS("opacity", "1");
  await page.getByRole("button", { name: "Tiki Twist", exact: true }).click();
  await expect(page.locator(".core-selected-title")).toHaveText("Tiki Twist");
  await page.getByRole("button", { name: "03 Enter world", exact: true }).click();
  await expect(hero).toHaveAttribute("data-chapter", "2");
  await expect(page.locator(".core-world-copy")).toHaveCSS("opacity", "1");
  await page.getByRole("button", { name: "01 Ignite", exact: true }).click();
  await expect(hero).toHaveAttribute("data-chapter", "0");
  await expect(page.locator(".core-intro")).toHaveCSS("opacity", "1");
  expect(errors).toEqual([]);
});

test("pause and resume release and restore WebGL", async ({ page }) => {
  await page.goto("/");
  await expect(page.locator(".core-ready")).toBeVisible();
  await page.getByRole("button", { name: "02 Unfold", exact: true }).click();
  await expect(page.locator(".core-unfold")).toHaveCSS("opacity", "1");
  await page.getByRole("button", { name: "Pause motion" }).click();
  await expect(page.locator(".core-still")).toBeVisible();
  await expect(page.locator(".core-canvas canvas")).toHaveCount(0);
  await expect(page.getByRole("heading", { level: 1 })).toBeInViewport();
  await page.getByRole("button", { name: "Resume motion" }).click();
  await expect(page.locator(".core-canvas canvas")).toHaveCount(1);
});

for (const mode of ["reduced", "no-webgl", "context-loss"]) {
  test(`${mode} has a usable static hero`, async ({ page }) => {
    if (mode === "reduced") await page.emulateMedia({ reducedMotion: "reduce" });
    await page.goto(mode === "no-webgl" ? "/?no-webgl" : "/");
    if (mode === "context-loss") {
      await expect(page.locator(".core-ready")).toBeVisible();
      await page.locator(".core-canvas canvas").evaluate(canvas => canvas.dispatchEvent(new Event("webglcontextlost", { cancelable: true })));
    }
    await expect(page.locator(".core-still")).toBeVisible();
    await expect(page.locator(".core-canvas canvas")).toHaveCount(0);
    await expect(page.getByRole("heading", { level: 1 })).toBeVisible();
    await expect(page.getByRole("link", { name: "Explore games", exact: true })).toBeVisible();
    const results = await new AxeBuilder({ page }).include(".play-core-hero").analyze();
    expect(results.violations.map(violation => ({ id: violation.id, nodes: violation.nodes.map(node => node.target) }))).toEqual([]);
  });
}

test("mobile scroll chapters stay inside the viewport", async ({ page }) => {
  await page.setViewportSize({ width: 390, height: 844 });
  await page.goto("/");
  await expect(page.locator(".core-ready")).toBeVisible();
  await page.getByRole("button", { name: "02 Unfold", exact: true }).click();
  await expect(page.locator(".core-unfold")).toHaveCSS("opacity", "1");
  await expect(page.getByRole("button", { name: "Tiki Twist", exact: true })).toBeInViewport();
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
});

test("keyboard entry and short viewport keep controls reachable", async ({ page }) => {
  await page.goto("/");
  await expect(page.locator(".core-ready")).toBeVisible();
  const enter = page.getByRole("button", { name: "Enter the system" });
  await enter.focus();
  await expect(enter).toBeFocused();
  await expect(enter).toHaveCSS("outline-style", "solid");
  await page.keyboard.press("Enter");
  await expect(page.locator(".core-unfold")).toHaveCSS("opacity", "1");
  await page.setViewportSize({ width: 720, height: 450 });
  await page.goto("/");
  await expect(page.locator(".core-still")).toBeVisible();
  await page.getByRole("button", { name: "Enter the system" }).scrollIntoViewIfNeeded();
  await expect(page.getByRole("button", { name: "Enter the system" })).toBeInViewport();
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
});
